# Access
ACCESS_CODE=
SESSION_SECRET=

# Cost and likeness controls
SPEND_CAP_USD=10
FACE_T=80

# Image models: MachGen (GPT Image 2.5 Flare and Sunburst, adult route).
# Child route, same key: Seedream 5.0 Lite (partner-hosted, ByteDance) and FLUX.2 dev (MachGen GPUs).
MACHGEN_API_KEY=

# Vision model on xKiro (kit, scene mood, body check). Free tier: a daily token allowance, then 429.
XKIRO_API_KEY=
# Optional; default qwen/qwen3-vl-plus:free. Backups on 429/503: qwen3.7-flash, qwen3.5-omni-flash (free).
VISION_MODEL=

# AWS Rekognition
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Vercel Blob (private store)
BLOB_READ_WRITE_TOKEN=

# Neon Postgres
DATABASE_URL=
